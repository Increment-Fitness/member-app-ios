{
  "expo": {
    "name": "Increment Fitness",
    "slug": "increment-fitness",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Increment Fitness to use the camera to take progress photos and scan food barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Increment Fitness to access your photos to add progress photos."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8e5dd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tatedev.increment-app.dev",
      "infoPlist": {
        "CFBundleDisplayName": "Increment Fitness",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e8e5dd"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
